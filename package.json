{
  "name": "nosh-research",
  "version": "0.1.0",
  "private": true,
  "description": "Networked Orchestrated Science Harness",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "corepack pnpm build && corepack pnpm -r test",
    "typecheck": "tsc -b",
    "notices": "node scripts/generate-notices.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "package:windows": "node scripts/package-release.mjs",
    "quality": "node scripts/quality-check.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "delegate": "node scripts/delegate.mjs",
    "context:audit": "node scripts/context-audit.mjs",
    "schemas": "corepack pnpm build && node scripts/generate-schema-fixtures.mjs",
    "release:check": "corepack pnpm install --frozen-lockfile && corepack pnpm quality && corepack pnpm test && corepack pnpm release:smoke && corepack pnpm notices && corepack pnpm run sbom"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "zod-to-json-schema": "3.24.6"
  }
}
