{
  "$ref": "#/definitions/runtime-instruction",
  "definitions": {
    "runtime-instruction": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "$schema": {
              "type": "string",
              "const": "https://nosh.dev/schemas/runtime-instruction/v1"
            },
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "instructionId": {
              "type": "string",
              "pattern": "^ins_[0-9a-f]{32}$"
            },
            "projectId": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{32}$"
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200
            },
            "proposedByAgentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^agt_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "issuedAt": {
              "type": "string",
              "format": "date-time"
            },
            "operation": {
              "type": "string",
              "const": "THREAD_OPEN"
            },
            "threadId": {
              "type": "string",
              "pattern": "^thr_[0-9a-f]{32}$"
            },
            "taskId": {
              "type": "string",
              "pattern": "^tsk_[0-9a-f]{32}$"
            },
            "initialAgentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^agt_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ownerScope": {
              "type": "object",
              "properties": {
                "missionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^mis_[0-9a-f]{32}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "directionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^dir_[0-9a-f]{32}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "autoresearchId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^ar_[0-9a-f]{32}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "experimentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^exp_[0-9a-f]{32}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "graphNodeId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "missionId",
                "directionId",
                "autoresearchId",
                "experimentId",
                "graphNodeId"
              ],
              "additionalProperties": false
            },
            "role": {
              "type": "string",
              "enum": [
                "nosh",
                "mission_director",
                "research_director",
                "librarian_researcher",
                "general_worker",
                "reviewer"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "executionMode": {
              "type": "string",
              "enum": [
                "background",
                "foreground_fork"
              ]
            },
            "parentThreadId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^thr_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "maxItems": 500
            },
            "skillIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^skl_[0-9a-f]{32}$"
              },
              "maxItems": 100
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "maxItems": 500
            },
            "budget": {
              "type": "object",
              "properties": {
                "maximumToolCalls": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "maximumModelTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "maximumWallClockSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "maximumToolCalls",
                "maximumModelTokens",
                "maximumWallClockSeconds"
              ],
              "additionalProperties": false
            }
          },
