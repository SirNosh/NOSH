{
  "$ref": "#/definitions/direction-status",
  "definitions": {
    "direction-status": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/direction-status/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "directionId": {
          "type": "string",
          "pattern": "^dir_[0-9a-f]{32}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "proposed",
            "active",
            "paused",
            "blocked",
            "reviewing",
            "closed",
            "rejected",
            "stopped"
          ]
        },
        "graphVersion": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "evaluationContractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "questionDisposition": {
          "type": "string",
          "enum": [
            "unresolved",
            "supported",
            "refuted",
            "inconclusive"
          ]
        },
        "owningWorkerLogicalId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "owningAgentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^agt_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeCounts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "autoresearchCounts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "acceptedFrontierExperimentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "activeTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{32}$"
          }
        },
        "activeJobIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          }
        },
        "openBlockingDefectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "remainingUncertaintyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "budget": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "latestPersistentSequence": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "directionId",
        "state",
        "graphVersion",
        "evaluationContractHash",
        "questionDisposition",
        "owningWorkerLogicalId",
        "owningAgentId",
        "nodeCounts",
        "autoresearchCounts",
        "acceptedFrontierExperimentIds",
        "activeTaskIds",
        "activeJobIds",
        "openBlockingDefectIds",
        "remainingUncertaintyIds",
        "budget",
        "latestPersistentSequence",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/direction-status/v1"
}
