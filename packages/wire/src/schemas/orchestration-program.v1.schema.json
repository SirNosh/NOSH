{
  "$ref": "#/definitions/orchestration-program",
  "definitions": {
    "orchestration-program": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/orchestration-program/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "programId": {
          "type": "string",
          "pattern": "^prg_[0-9a-f]{32}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "startStepId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "maximumSteps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "maximumWallClockSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maximumModelTokens": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maximumToolCalls": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "state": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
              "maxLength": 128
            },
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "ref",
                  "json"
                ]
              },
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              }
            },
            "initial": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {}
                  },
                  {
                    "type": "object",
                    "additionalProperties": {}
                  }
                ]
              },
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,127}$"
              }
            }
          },
          "required": [
            "namespace",
            "schema",
            "initial"
          ],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "instruction": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {}
                    },
                    {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  ]
                }
              },
              "guard": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "exists",
                          "equals",
                          "not_equals"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {}
                              },
                              {
                                "type": "object",
                                "additionalProperties": {}
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "ref",
                      "operator",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "background": {
                "type": "boolean"
              },
              "outputStateKey": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nextStepId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "failureStepId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stepId",
              "instruction",
              "guard",
              "background",
              "outputStateKey",
              "nextStepId",
              "failureStepId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "programId",
        "name",
        "version",
        "startStepId",
        "maximumSteps",
        "maximumWallClockSeconds",
        "maximumModelTokens",
        "maximumToolCalls",
        "state",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/orchestration-program/v1"
}
