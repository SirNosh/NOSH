{
  "$ref": "#/definitions/episode",
  "definitions": {
    "episode": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/episode/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "episodeId": {
          "type": "string",
          "pattern": "^epi_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "threadId": {
          "type": "string",
          "pattern": "^thr_[0-9a-f]{32}$"
        },
        "instructionId": {
          "type": "string",
          "pattern": "^ins_[0-9a-f]{32}$"
        },
        "stepNumber": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "episodeType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                  "maxLength": 128
                },
                "maxItems": 500
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "default": "medium"
              }
            },
            "required": [
              "statement",
              "evidenceRefs"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                  "maxLength": 128
                },
                "maxItems": 500
              }
            },
            "required": [
              "statement",
              "rationale",
              "evidenceRefs"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          },
          "maxItems": 200
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evd_[0-9a-f]{32}$"
          },
          "maxItems": 200
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 200
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 200
        },
        "recommendedNextActions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "THREAD_OPEN",
                  "THREAD_STEP",
                  "THREAD_FORK",
                  "THREAD_AWAIT",
                  "THREAD_COMPOSE",
                  "THREAD_PAUSE",
                  "THREAD_CANCEL",
                  "SKILL_APPLY",
                  "DIRECT_ACTION",
                  "STOP"
                ]
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "operation",
              "objective"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "contextInputRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "trace": {
          "type": "object",
          "properties": {
            "firstSequence": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "lastSequence": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "firstSequence",
            "lastSequence"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "modelTokens": {
              "type": "integer",
              "minimum": 0
            },
            "wallClockSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "toolCalls",
            "modelTokens",
            "wallClockSeconds"
          ],
          "additionalProperties": false
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "episodeHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "episodeId",
        "projectId",
        "threadId",
        "instructionId",
        "stepNumber",
        "episodeType",
        "objective",
        "status",
        "summary",
        "facts",
        "decisions",
        "artifactIds",
        "evidenceIds",
        "changedFiles",
        "unresolvedQuestions",
        "recommendedNextActions",
        "contextInputRefs",
        "trace",
        "usage",
        "startedAt",
        "completedAt",
        "episodeHash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/episode/v1"
}
