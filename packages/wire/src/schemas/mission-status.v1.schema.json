{
  "$ref": "#/definitions/mission-status",
  "definitions": {
    "mission-status": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/mission-status/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "missionId": {
          "type": "string",
          "pattern": "^mis_[0-9a-f]{32}$"
        },
        "objectiveVersion": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "graphVersion": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "planning",
            "awaiting_approval",
            "running",
            "pausing",
            "paused",
            "reviewing",
            "blocked",
            "stopping",
            "completed",
            "stopped",
            "failed"
          ]
        },
        "nodeCounts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "criticalPathNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "activeTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{32}$"
          }
        },
        "activeJobIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^job_[0-9a-f]{32}$"
          }
        },
        "openBlockingDefectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "budget": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "focus": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "latestPersistentSequence": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "missionId",
        "objectiveVersion",
        "graphVersion",
        "state",
        "nodeCounts",
        "criticalPathNodeIds",
        "activeTaskIds",
        "activeJobIds",
        "openBlockingDefectIds",
        "budget",
        "focus",
        "latestPersistentSequence",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/mission-status/v1"
}
