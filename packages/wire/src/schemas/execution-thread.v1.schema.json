{
  "$ref": "#/definitions/execution-thread",
  "definitions": {
    "execution-thread": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/execution-thread/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "threadId": {
          "type": "string",
          "pattern": "^thr_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{32}$"
        },
        "ownerScope": {
          "type": "object",
          "properties": {
            "missionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^mis_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "directionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^dir_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "autoresearchId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^ar_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "experimentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^exp_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "graphNodeId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "missionId",
            "directionId",
            "autoresearchId",
            "experimentId",
            "graphNodeId"
          ],
          "additionalProperties": false
        },
        "role": {
          "type": "string",
          "enum": [
            "nosh",
            "mission_director",
            "research_director",
            "librarian_researcher",
            "general_worker",
            "reviewer"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "executionMode": {
          "type": "string",
          "enum": [
            "background",
            "foreground_fork"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "running",
            "awaiting",
            "awaiting_user",
            "paused",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "parentThreadId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^thr_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "childThreadIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^thr_[0-9a-f]{32}$"
          },
          "maxItems": 200
        },
        "currentAgentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^agt_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentPiSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeInstructionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^ins_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
                "pattern": "^agt_[0-9a-f]{32}$"
              },
              "piSessionId": {
                "type": "string",
                "minLength": 1
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "endedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "rotated",
                      "completed",
                      "cancelled",
                      "failed"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "agentId",
              "piSessionId",
              "startedAt",
              "endedAt",
              "endReason"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "episodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^epi_[0-9a-f]{32}$"
          },
          "maxItems": 10000
        },
        "inputRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "activeSkillIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^skl_[0-9a-f]{32}$"
          },
          "maxItems": 100
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "taskPermissions": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "network": {
                  "type": "string",
                  "enum": [
                    "disabled",
                    "allowlisted",
                    "enabled"
                  ]
                },
                "subprocess": {
                  "type": "string",
                  "enum": [
                    "disabled",
                    "allowlisted",
                    "enabled"
                  ]
                },
                "gitCommit": {
                  "type": "boolean"
                },
                "gitPush": {
                  "type": "boolean"
                },
                "delegation": {
                  "type": "string",
                  "const": "request_only"
                },
                "networkAllowlist": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                  },
                  "maxItems": 32
                },
                "allowedToolIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                    "maxLength": 128
                  }
                }
              },
              "required": [
                "network",
                "subprocess",
                "gitCommit",
                "gitPush",
                "delegation",
                "networkAllowlist",
                "allowedToolIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "taskWorkspace": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "worktreeId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                  "maxLength": 128
                },
                "branch": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                },
                "startingCommit": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "writeScopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "maxItems": 100
                },
                "protectedScopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "worktreeId",
                "branch",
                "startingCommit",
                "writeScopes",
                "protectedScopes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "maximumToolCalls": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maximumModelTokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maximumWallClockSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "maximumToolCalls",
            "maximumModelTokens",
            "maximumWallClockSeconds"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "modelTokens": {
              "type": "integer",
              "minimum": 0
            },
            "wallClockSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "toolCalls",
            "modelTokens",
            "wallClockSeconds"
          ],
          "additionalProperties": false
        },
        "nextStepNumber": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "threadId",
        "projectId",
        "taskId",
        "ownerScope",
        "role",
        "purpose",
        "executionMode",
        "state",
        "parentThreadId",
        "childThreadIds",
        "currentAgentId",
        "currentPiSessionId",
        "activeInstructionId",
        "sessionHistory",
        "episodeIds",
        "inputRefs",
        "activeSkillIds",
        "capabilities",
        "taskPermissions",
        "taskWorkspace",
        "budget",
        "usage",
        "nextStepNumber",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/execution-thread/v1"
}
