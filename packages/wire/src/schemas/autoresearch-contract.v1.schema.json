{
  "$ref": "#/definitions/autoresearch-contract",
  "definitions": {
    "autoresearch-contract": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/autoresearch-contract/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "templateVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "autoresearchId": {
          "type": "string",
          "pattern": "^ar_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "missionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^mis_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "directionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^dir_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "invokedByRole": {
          "type": "string",
          "enum": [
            "user",
            "mission_director",
            "research_director"
          ]
        },
        "decisionQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "distinctPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "hypothesisFamilyTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 200
        },
        "duplicateCheck": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "evaluationContractId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "evaluationContractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rootExperimentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "acceptedFrontierExperimentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "allowedChangeScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "forbiddenChangeScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "variantPolicy": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "stopConditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {}
                },
                {
                  "type": "object",
                  "additionalProperties": {}
                }
              ]
            }
          },
          "minItems": 1
        },
        "promotionRubricIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "contractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "templateVersion",
        "autoresearchId",
        "projectId",
        "missionId",
        "directionId",
        "invokedByRole",
        "decisionQuestion",
        "distinctPurpose",
        "hypothesisFamilyTags",
        "duplicateCheck",
        "evaluationContractId",
        "evaluationContractHash",
        "rootExperimentId",
        "acceptedFrontierExperimentIds",
        "allowedChangeScopes",
        "forbiddenChangeScopes",
        "variantPolicy",
        "budgets",
        "stopConditions",
        "promotionRubricIds",
        "createdAt",
        "contractHash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/autoresearch-contract/v1"
}
