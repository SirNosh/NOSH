{
  "$ref": "#/definitions/event",
  "definitions": {
    "event": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/event/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "retention": {
          "type": "string",
          "enum": [
            "persistent",
            "ephemeral"
          ]
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{32}$"
            },
            "missionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^mis_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "directionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^dir_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "autoresearchId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^ar_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "experimentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^exp_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^run_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "jobId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^job_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agentId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^agt_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "missionId",
            "directionId",
            "autoresearchId",
            "experimentId",
            "runId",
            "jobId",
            "agentId"
          ],
          "additionalProperties": false
        },
        "correlationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "causationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^evt_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "object",
              "additionalProperties": {}
            }
          ]
        },
        "eventId": {
          "type": "string",
          "pattern": "^evt_[0-9a-f]{32}$"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "retention",
        "type",
        "source",
        "scope",
        "correlationId",
        "causationId",
        "payload",
        "eventId",
        "sequence",
        "timestamp"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/event/v1"
}
