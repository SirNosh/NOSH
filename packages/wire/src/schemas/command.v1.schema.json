{
  "$ref": "#/definitions/command",
  "definitions": {
    "command": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/command/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "commandId": {
          "type": "string",
          "pattern": "^cmd_[0-9a-f]{32}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "targetType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "observedVersions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "payload": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "object",
              "additionalProperties": {}
            }
          ]
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "commandId",
        "idempotencyKey",
        "projectId",
        "targetType",
        "targetId",
        "expectedVersion",
        "type",
        "observedVersions",
        "payload",
        "issuedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/command/v1"
}
