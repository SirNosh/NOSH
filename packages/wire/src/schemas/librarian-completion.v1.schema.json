{
  "$ref": "#/definitions/librarian-completion",
  "definitions": {
    "librarian-completion": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/librarian-completion/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "taskOutcome": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "researchQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "searchCoverage": {
          "type": "object",
          "properties": {
            "databases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 100
            },
            "queries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 100
            },
            "dateRange": {
              "type": "object",
              "properties": {
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "language": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 100
            },
            "inclusionCriteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 100
            },
            "exclusionCriteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "maxItems": 100
            }
          },
          "required": [
            "databases",
            "queries",
            "dateRange",
            "language",
            "inclusionCriteria",
            "exclusionCriteria"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "sourceType": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "authors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "maxItems": 100
              },
              "publicationDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "canonicalUrl": {
                "type": "string",
                "format": "uri"
              },
              "persistentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "type": "string",
                "maxLength": 200
              },
              "primarySource": {
                "type": "boolean"
              },
              "accessedAt": {
                "type": "string",
                "format": "date-time"
              },
              "artifactId": {
                "type": "string",
                "pattern": "^art_[0-9a-f]{32}$"
              },
              "relevance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "sourceId",
              "sourceType",
              "title",
              "authors",
              "publicationDate",
              "canonicalUrl",
              "persistentId",
              "version",
              "primarySource",
              "accessedAt",
              "artifactId",
              "relevance"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "findingId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "support": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                      "maxLength": 128
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "artifactId": {
                      "type": "string",
                      "pattern": "^art_[0-9a-f]{32}$"
                    }
                  },
                  "required": [
                    "sourceId",
                    "locator",
                    "artifactId"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "noveltyImplication": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "findingId",
              "statement",
              "support",
              "confidence",
              "noveltyImplication"
            ],
            "additionalProperties": false
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "evaluationDifferences": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "knowledgeGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 100
        },
        "candidateClaimEffects": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "bibliographyArtifactId": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "reportArtifactId": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "readyForReview": {
          "type": "boolean"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "taskOutcome",
        "researchQuestion",
        "searchCoverage",
        "sources",
        "findings",
        "contradictions",
        "evaluationDifferences",
        "knowledgeGaps",
        "candidateClaimEffects",
        "bibliographyArtifactId",
        "reportArtifactId",
        "readyForReview"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/librarian-completion/v1"
}
