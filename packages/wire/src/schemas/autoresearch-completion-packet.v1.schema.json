{
  "$ref": "#/definitions/autoresearch-completion-packet",
  "definitions": {
    "autoresearch-completion-packet": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/autoresearch-completion-packet/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "completionPacketId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "autoresearchId": {
          "type": "string",
          "pattern": "^ar_[0-9a-f]{32}$"
        },
        "directionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^dir_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluationContractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "terminalReason": {
          "type": "string",
          "enum": [
            "target_reached",
            "budget_exhausted",
            "evidence_saturation",
            "all_hypotheses_rejected",
            "contract_invalid",
            "loop_protection",
            "owner_stop",
            "review_invalid"
          ]
        },
        "budgetUse": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "tree": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "decisionAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "bestExperimentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evd_[0-9a-f]{32}$"
          }
        },
        "failedHypothesisIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
            "maxLength": 128
          },
          "maxItems": 500
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "synthesisArtifactId": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "deterministicValidation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "pass"
            },
            "validatorRunIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "maxItems": 500
            }
          },
          "required": [
            "status",
            "validatorRunIds"
          ],
          "additionalProperties": false
        },
        "closureReviewId": {
          "type": "string",
          "pattern": "^rev_[0-9a-f]{32}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "completionPacketId",
        "autoresearchId",
        "directionId",
        "evaluationContractHash",
        "terminalReason",
        "budgetUse",
        "tree",
        "decisionAnswer",
        "bestExperimentId",
        "evidenceIds",
        "failedHypothesisIds",
        "unresolvedQuestions",
        "synthesisArtifactId",
        "deterministicValidation",
        "closureReviewId",
        "completedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/autoresearch-completion-packet/v1"
}
