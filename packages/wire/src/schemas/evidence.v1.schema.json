{
  "$ref": "#/definitions/evidence",
  "definitions": {
    "evidence": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/evidence/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "evidenceId": {
          "type": "string",
          "pattern": "^evd_[0-9a-f]{32}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "evidenceType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "polarity": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "qualifies"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "refType": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "refId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
                "maxLength": 128
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "refType",
              "refId",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evaluationContractHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopeLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "quality": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unreviewed",
                "reviewed",
                "rejected"
              ]
            },
            "reviewId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^rev_[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "status",
            "reviewId",
            "confidence"
          ],
          "additionalProperties": false
        },
        "createdByAgentId": {
          "type": "string",
          "pattern": "^agt_[0-9a-f]{32}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "evidenceId",
        "projectId",
        "evidenceType",
        "statement",
        "polarity",
        "sourceRefs",
        "evaluationContractHash",
        "scopeLimitations",
        "quality",
        "createdByAgentId",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/evidence/v1"
}
