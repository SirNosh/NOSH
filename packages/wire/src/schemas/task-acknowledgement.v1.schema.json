{
  "$ref": "#/definitions/task-acknowledgement",
  "definitions": {
    "task-acknowledgement": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/task-acknowledgement/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{32}$"
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "agentId": {
          "type": "string",
          "pattern": "^agt_[0-9a-f]{32}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected_conflict",
            "rejected_missing_input",
            "rejected_permission",
            "clarification_required"
          ]
        },
        "understoodObjective": {
          "type": "string",
          "maxLength": 2000
        },
        "understoodOutputIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "understoodCriterionIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "observedLeaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observedStartingCommit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 128
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 50
        },
        "clarificationRequest": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "taskId",
        "attempt",
        "agentId",
        "decision",
        "understoodObjective",
        "understoodOutputIds",
        "understoodCriterionIds",
        "observedLeaseId",
        "observedStartingCommit",
        "conflicts",
        "clarificationRequest",
        "submittedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/task-acknowledgement/v1"
}
