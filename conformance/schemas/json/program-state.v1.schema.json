{
  "$ref": "#/definitions/program-state",
  "definitions": {
    "program-state": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/program-state/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "projectId": {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{32}$"
        },
        "programId": {
          "type": "string",
          "pattern": "^prg_[0-9a-f]{32}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
          "maxLength": 128
        },
        "fieldTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "ref",
              "json"
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,127}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "completed",
            "failed",
            "stopped"
          ]
        },
        "currentStepId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*_[a-z0-9][a-z0-9.:-]*$",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "stepsExecuted": {
          "type": "integer",
          "minimum": 0
        },
        "executionCount": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "properties": {
            "toolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "modelTokens": {
              "type": "integer",
              "minimum": 0
            },
            "wallClockSeconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "toolCalls",
            "modelTokens",
            "wallClockSeconds"
          ],
          "additionalProperties": false
        },
        "checkpoint": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {}
                },
                {
                  "type": "object",
                  "additionalProperties": {}
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "projectId",
        "programId",
        "namespace",
        "fieldTypes",
        "values",
        "status",
        "currentStepId",
        "stepsExecuted",
        "executionCount",
        "usage",
        "checkpoint",
        "startedAt",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/program-state/v1"
}
