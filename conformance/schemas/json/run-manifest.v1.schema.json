{
  "$ref": "#/definitions/run-manifest",
  "definitions": {
    "run-manifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://nosh.dev/schemas/run-manifest/v1"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "experimentId": {
          "type": "string",
          "pattern": "^exp_[0-9a-f]{32}$"
        },
        "evaluationContractHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evaluatedCommit": {
          "type": "string",
          "minLength": 7
        },
        "seed": {
          "type": "integer"
        },
        "resolvedCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "workingDirectory": {
          "type": "string"
        },
        "inputArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          }
        },
        "configurationArtifactId": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "environmentManifestArtifactId": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "hardware": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          }
        },
        "jobId": {
          "type": "string",
          "pattern": "^job_[0-9a-f]{32}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "lost"
          ]
        },
        "metricArtifactId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^art_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredOutputArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "runId",
        "experimentId",
        "evaluationContractHash",
        "evaluatedCommit",
        "seed",
        "resolvedCommand",
        "workingDirectory",
        "inputArtifactIds",
        "configurationArtifactId",
        "environmentManifestArtifactId",
        "hardware",
        "jobId",
        "state",
        "metricArtifactId",
        "requiredOutputArtifactIds",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosh.dev/schemas/run-manifest/v1"
}
